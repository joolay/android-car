<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF0B0E13</color>
    <color name="accent">#FF3D8BFD</color>
    <color name="icon_bg">#FF151A22</color>

    <string name="app_name">Car Launcher</string>
    <string name="kb_name">Car keyboard</string>
    <string name="kb_subtype">English</string>
    <string name="fb_name">Car Launcher call helper</string>
    <string name="fb_desc">Works your box\'s BT Phone app for you: it reads only BT Phone\'s own screens, to show incoming calls in Car Launcher, press its Answer and Decline buttons and type in numbers you dial. It does not read any other app.</string>

    <style name="LauncherTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
